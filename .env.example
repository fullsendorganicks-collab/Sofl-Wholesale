# ---- Database (Supabase) ----
# Get this from Supabase Project Settings > Database > Connection String (URI, use "Transaction" pooler for Render)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:6543/postgres

# ---- Anthropic (Claude API) ----
# Get from console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# ---- BatchData (property/owner data - Zillow API replacement) ----
# Get from batchdata.com after signing up for API access
BATCHDATA_API_KEY=xxxxxxxx

# ---- Gmail API (Google Cloud Console) ----
# See README.md "Gmail Setup" section for step-by-step console instructions
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
GOOGLE_REFRESH_TOKEN=xxxxxxxx
GMAIL_SENDER_ADDRESS=you@yourdomain.com

# ---- Twilio (SMS for urgent daily brief alerts) ----
# Get from twilio.com console after buying a phone number
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_FROM_NUMBER=+1561XXXXXXX

# ---- App config ----
DEFAULT_ASSIGNMENT_FEE_TARGET=12000
ARV_MULTIPLIER=0.70

# ---- Your org (insert into `orgs` table first, then put the returned UUID here
# for convenience when testing manually via curl/Postman) ----
MY_ORG_ID=
MY_ORG_NAME=Nick - Primary
MY_CONTACT_EMAIL=
MY_CONTACT_PHONE=
